{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roblox Crosshair Manager",
  "version": "1.1.2",
  "identifier": "com.roblox-crosshair-manager.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1733",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Roblox Crosshair Manager",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4NTREMzZEMTdDMUJCRkQKUldUOXU4RVhiZE5VV0ppdVByM3BMUi9LV1ZHUFg5bmcrNTNVdHB2U1VWcDc0THorYlpuVE5mWWwK",
      "endpoints": [
        "https://raw.githubusercontent.com/NorringDev/Roblox-Custom-Cursor/main/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/premade/**/*"]
  }
}
